/* components/nav-bar/index.wxss —— 微信原生风：白底黑字 */
.custom-navbar {
  padding: 0 15px;
  background-color: #fff;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  z-index: 9998;
}
.custom-navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
}

.custom-navbar-title {
  font-size: 18px;
  font-weight: 500;
  text-align: center;
}

.nav-bar {
  position: fixed;
  width: 100%;
  top: 0;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  background: #fff;
}
.nav-amin {
  position: relative;
  text-align: center;
  box-sizing: border-box;
}

.icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 96rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.nav-bar .search {
  font-size: 17px;
  font-weight: 500;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
}
