/* custom-tab-bar —— 微信原生风格：白底细线，选中态绿色图标+文字 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid var(--weui-separator, rgba(0, 0, 0, 0.1));
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.t-tab-bar-item__content--checked {
  color: #07c160 !important;
  font-weight: 500;
}
