/* 我的 —— 微信「我的」页面风格 */
.user-page {
  min-height: 100vh;
  background-color: var(--weui-bg, #ededed);
  padding-bottom: 80rpx;
}
/* 顶部资料区：白底通栏 */
.profile-card {
  background: #fff;
}
.profile-content {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
}
/* 头像按钮：重置原生 button 样式，仅承担 chooseAvatar 能力 */
.avatar-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  border: none;
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  display: block;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}
.avatar-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
}
.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  overflow: hidden;
}
.nickname {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub {
  font-size: 26rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
}
.sub.placeholder {
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
}
.mobile.placeholder {
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
}

/* 统计卡 */
.stats-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 32rpx 0;
}
.stats-item {
  flex: 1;
  text-align: center;
}
.stats-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  line-height: 1.2;
}
.stats-label {
  font-size: 24rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
  margin-top: 8rpx;
}
.stats-divider {
  width: 1px;
  height: 48rpx;
  background-color: var(--weui-separator, rgba(0, 0, 0, 0.1));
  transform: scaleY(0.5);
}

/* 菜单组：图标与箭头对齐微信绿/灰 */
.menu-group {
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  --td-cell-left-icon-color: var(--weui-primary, #07c160);
  --td-cell-right-icon-color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
}

/* 退出登录 */
.logout-cell {
  margin: 24rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--weui-red, #fa5151);
}
.cell-hover {
  background: #f7f7f7;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
  margin-top: 48rpx;
}
