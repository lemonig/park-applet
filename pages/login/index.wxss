/* 登录 —— 微信原生（WeUI）风格：浅灰底、微信绿按钮、蓝色链接 */
.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx 64rpx;
  box-sizing: border-box;
  background: var(--weui-bg, #ededed);
  overflow: hidden;
}

.brand {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

.title {
  margin-top: 40rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  letter-spacing: 4rpx;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
}

.login-body {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 96rpx;
}

.login-panel {
  width: 100%;
  box-sizing: border-box;
}

.welcome {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
}

.welcome-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
}

.primary-btn {
  margin-top: 64rpx;
  --td-button-large-height: 96rpx;
  --td-button-border-radius: 16rpx;
  font-weight: 500;
}

.wechat-btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.error-message {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--weui-red, #fa5151);
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  padding-top: 56rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
}

.agreement-text .link {
  color: var(--weui-link, #576b95);
}
