/* 发布/编辑车位表单 —— 微信原生（WeUI）风格，表单基础样式见 app.wxss */
.form-page {
  min-height: 100vh;
  padding: 8rpx 0 40rpx;
  box-sizing: border-box;
}

.submit-spacer {
  height: 160rpx;
}

/* 靠近楼栋标签组 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 楼栋 tag：微信风方角，选中态微信绿 */
.building-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx !important;
  padding: 0 28rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.building-tag.t-tag--default {
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55)) !important;
  background-color: #f7f7f7 !important;
  border-color: #f7f7f7 !important;
}

.building-tag.t-tag--checked {
  color: #ffffff !important;
  background: var(--weui-primary, #07c160) !important;
  border-color: var(--weui-primary, #07c160) !important;
}

/* 小区选择入口 */
.community-cell-bd {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.community-value {
  font-size: 30rpx;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  text-align: right;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.community-placeholder {
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.35));
}

.community-arrow {
  margin-left: 12rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.35));
  font-size: 32rpx;
}
