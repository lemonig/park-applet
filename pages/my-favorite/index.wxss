/* 我的收藏 —— 卡片样式与首页列表一致 */
.page-container {
  background-color: var(--weui-bg, #ededed);
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.list-section {
  padding: 24rpx;
}
.parking-card {
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: row;
}
/* 标题行右侧：类型标签 + 收藏星标 */
.header-right {
  display: flex;
  align-items: center;
}
/* 星标固定为已收藏态：点击即取消收藏，扩一点热区 */
.fav-btn {
  padding: 8rpx 0 8rpx 16rpx;
  margin: -8rpx 0;
  line-height: 1;
}
.card-left {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.status-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
  font-weight: 500;
}
.status-active {
  background-color: var(--weui-primary, #07c160);
}
.status-sold {
  background-color: #b2b2b2;
}
.card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.parking-number {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
}
.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.margin-tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}
.price-box {
  color: var(--weui-red, #fa5151);
  line-height: 1;
}
.currency {
  font-size: 24rpx;
  font-weight: bold;
}
.amount {
  font-size: 40rpx;
  font-weight: bold;
  margin: 0 4rpx;
}
.unit {
  font-size: 24rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
  font-weight: normal;
}
.list-tip {
  text-align: center;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
  font-size: 24rpx;
  padding: 24rpx 0;
}
