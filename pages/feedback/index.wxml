<navigation-bar default-data="{{titleProps}}" back="{{true}}" is-cus-back="{{true}}" bind:customBack="onBack"></navigation-bar>

<view class="form-page">
  <!-- 问题类型 -->
  <view class="weui-cells__title">问题类型</view>
  <view class="weui-cells radio-cells">
    <t-radio-group value="{{form.type}}" bind:change="onTypeChange" class="radio-group">
      <t-radio wx:for="{{typeOptions}}" wx:key="value" value="{{item.value}}" label="{{item.label}}" borderless />
    </t-radio-group>
  </view>

  <!-- 问题描述 -->
  <view class="weui-cells__title">问题描述</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_block">
      <view class="cell-block-title">描述越具体越容易解决<text class="cell-block-tip">10-500字</text></view>
      <textarea
        class="weui-textarea"
        value="{{form.content}}"
        placeholder="请描述遇到的问题或想提的建议，如：在哪个功能、发生了什么、期望的表现"
        placeholder-class="weui-input__placeholder"
        maxlength="500"
        auto-height
        data-field="content"
        bindinput="onInput"
      />
      <view class="weui-textarea-counter">{{form.content.length}}/500</view>
    </view>
  </view>

  <!-- 截图与联系方式 -->
  <view class="weui-cells__title">截图与联系方式</view>
  <view class="weui-cells">
    <view class="weui-cell weui-cell_block">
      <view class="cell-block-title">截图<text class="cell-block-tip">选填，便于我们定位问题</text></view>
      <view class="image-grid">
        <block wx:for="{{images}}" wx:key="id">
          <view class="image-item">
            <image src="{{item.url}}" mode="aspectFill" bind:tap="previewImage" data-index="{{index}}" />
            <view class="image-remove" bind:tap="removeImage" data-index="{{index}}">×</view>
          </view>
        </block>
        <view wx:if="{{images.length < 4}}" class="image-add" bind:tap="chooseImages">
          <view class="plus">+</view>
          <view class="add-text">{{uploading ? '上传中' : '上传截图'}}</view>
        </view>
      </view>
      <view class="upload-tip">最多上传4张截图</view>
    </view>
    <view class="weui-cell">
      <view class="weui-label">联系方式</view>
      <view class="weui-cell__bd">
        <input
          class="weui-input"
          type="number"
          value="{{form.contact}}"
          placeholder="选填，方便我们回访"
          placeholder-class="weui-input__placeholder"
          data-field="contact"
          bindinput="onInput"
        />
      </view>
    </view>
  </view>

  <view class="submit-spacer"></view>
</view>

<view class="submit-bar">
  <button
    class="weui-btn weui-btn_primary {{submitting || uploading ? 'weui-btn_disabled' : ''}}"
    hover-class="{{submitting || uploading ? 'none' : 'weui-btn_active'}}"
    loading="{{submitting}}"
    bind:tap="submitForm"
  >提交反馈</button>
</view>
