.form-page {
  min-height: 100vh;
  background-color: #f6f6f6;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* 顶部横幅 */
.type-banner {
  position: relative;
  margin-bottom: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, #0052d9 0%, #1e8ae8 100%);
  box-shadow: 0 14rpx 28rpx rgba(0, 82, 217, 0.18);
}
.type-banner::after {
  content: '';
  position: absolute;
  right: -48rpx;
  top: -64rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.type-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}
.type-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.form-card {
  margin-bottom: 24rpx;
  padding: 8rpx 0 16rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 28rpx 32rpx 12rpx;
}
.card-icon {
  position: relative;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.card-icon::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 4rpx;
  vertical-align: -4rpx;
  background: linear-gradient(180deg, #1e8ae8, #0052d9);
}
.card-title {
  font-size: 24rpx;
  color: #9ca3af;
}

.radio-list {
  padding: 8rpx 32rpx 16rpx;
}

.content-area {
  padding: 0 32rpx 16rpx;
}

.form-cell-title {
  font-size: 28rpx !important;
  color: #374151 !important;
}

.form-cell-note {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.upload-area {
  padding-top: 8rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 0 32rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  background: rgba(0, 0, 0, 0.55);
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #c9cdd4;
  box-sizing: border-box;
  color: #888;
}

.plus {
  font-size: 56rpx;
  line-height: 1;
}

.add-text {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.upload-tip {
  padding: 16rpx 32rpx 24rpx;
  font-size: 24rpx;
  color: #999;
}

.submit-spacer {
  height: 1rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 18rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.submit-bar .t-button {
  --td-button-large-height: 96rpx;
  --td-button-border-radius: 48rpx;
  --td-brand-color: #1e8ae8;
  font-weight: 600;
}
