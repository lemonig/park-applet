/* 意见反馈 —— 微信原生（WeUI）风格，表单基础样式见 app.wxss */
.form-page {
  min-height: 100vh;
  padding: 8rpx 0 40rpx;
  box-sizing: border-box;
}

.submit-spacer {
  height: 160rpx;
}

/* 问题类型单选组：TDesign radio 自带 32rpx 行内边距，垂直排布 */
.radio-group {
  display: block;
}

/* 截图九宫格与标题的间距 */
.image-grid {
  margin-top: 8rpx;
}
