/* 首页 —— 微信原生（WeUI）风格 */
.page-container {
  background-color: var(--weui-bg, #ededed);
  min-height: 100vh;
  padding-bottom: 40rpx;
}
/* 顶部搜索背景 */
.header-section {
  background-color: #fff;
  padding: 16rpx 24rpx;
  position: fixed;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box;
  opacity: 0;
  transform: translateY(-100%);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.header-section-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

/* 发布入口：白卡 + 彩色圆角图标 */
.action-section {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
}
.action-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.action-icon {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 24rpx;
}
.action-icon-sale {
  background: var(--td-brand-color-1, #f0faf3);
  color: var(--weui-primary, #07c160);
}
.action-icon-rent {
  background: #eef3fb;
  color: var(--weui-link, #576b95);
}
.action-content {
  min-width: 0;
}
.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  line-height: 1.2;
}
.action-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 列表容器 */
.list-section {
  padding: 0 24rpx 24rpx;
}
/* 卡片主体 */
.parking-card {
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: row;
}
/* 收藏星标：绝对定位卡片右上角，扩大热区 */
.fav-btn {
  position: absolute;
  top: 0;
  right: 0;
  padding: 16rpx;
}
/* 左侧布局 */
.card-left {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}
/* 自定义状态角标 */
.status-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
  font-weight: 500;
}
.status-active {
  background-color: var(--weui-primary, #07c160);
}
.status-sold {
  background-color: #b2b2b2;
}
/* 右侧布局 */
.card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
/* 编号 + 类型 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 编号标题 */
.parking-number {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
}
/* 列表底部提示 */
.list-tip {
  text-align: center;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
  font-size: 24rpx;
  padding: 24rpx 0;
}
/* 标签间距 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.margin-tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
/* 底部价格与按钮区域 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}
/* 价格样式：微信红 */
.price-box {
  color: var(--weui-red, #fa5151);
  line-height: 1;
}
.currency {
  font-size: 24rpx;
  font-weight: bold;
}
.amount {
  font-size: 40rpx;
  font-weight: bold;
  margin: 0 4rpx;
}
.unit {
  font-size: 24rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
  font-weight: normal;
}
