/* 车位详情 —— 微信原生（WeUI）风格 */
.page-container {
  background-color: var(--weui-bg, #ededed);
  min-height: 100vh;
  padding-bottom: 0;
}
/* 通用卡片样式 */
.info-card {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}
/* 头部卡片 */
.header-card {
  margin-top: 24rpx;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}
/* 价格行 */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.price-wrapper {
  color: var(--weui-red, #fa5151);
  display: flex;
  align-items: baseline;
}
.currency {
  font-size: 28rpx;
  font-weight: bold;
}
.amount {
  font-size: 56rpx;
  font-weight: bold;
  margin: 0 8rpx;
  line-height: 1;
}
.unit {
  font-size: 24rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
}
/* 标题行 */
.title-row {
  margin-bottom: 24rpx;
}
.main-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
}
/* 标签行 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag-item {
  margin-right: 0;
}
/* 版块标题：微信风纯粗体，去彩色竖条 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
  margin-bottom: 24rpx;
  line-height: 1.2;
}
/* 卡片内 cell 分组去掉自带圆角，贴合外层卡片 */
.info-card t-cell-group {
  --td-radius-large: 0;
  margin: 0 -32rpx -32rpx;
}
/* 纯文本块 */
.text-block {
  font-size: 28rpx;
  color: var(--weui-fg-2, rgba(0, 0, 0, 0.55));
  line-height: 1.6;
}
/* 驳回原因高亮 */
.reject-note {
  color: var(--weui-red, #fa5151) !important;
}
/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  width: 210rpx;
  height: 210rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}
/* 轮播容器 */
.swiper-wrap {
  margin-bottom: 24rpx;
}
/* 底部防遮挡占位 */
.bottom-spacer {
  height: 180rpx;
}
/* 底部固定栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-top: 1px solid var(--weui-separator, rgba(0, 0, 0, 0.1));
  /* 适配 iPhone X 底部黑条 */
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.btn-actions {
  flex: 1;
  display: flex;
  gap: 16rpx;
}
/* 强制覆盖 TDesign 按钮样式使其撑满 */
.btn-actions t-button {
  flex: 1;
}
