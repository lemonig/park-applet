<navigation-bar default-data="{{titleProps}}" back="{{true}}"></navigation-bar>

<view class="page-container" wx:if="{{loading}}">
  <t-skeleton theme="image" />
  <view class="info-card">
    <t-skeleton />
  </view>
</view>

<block wx:elif="{{detail.id}}">
  <view class="page-container">
    <view class="swiper-wrap" wx:if="{{swiperList.length}}">
      <t-swiper
        current="{{current}}"
        autoplay="{{false}}"
        navigation="{{ { type: 'fraction' } }}"
        list="{{swiperList}}"
        height="500rpx"
      />
    </view>

    <view class="info-card header-card">
      <view class="price-row">
        <view class="price-wrapper">
          <text class="currency">¥</text>
          <text class="amount">{{detail.priceText}}</text>
          <text class="unit">{{detail.unit}}</text>
        </view>
        <t-tag wx:if="{{statusText}}" variant="light" theme="{{statusTheme}}" shape="mark">{{statusText}}</t-tag>
      </view>

      <view class="title-row">
        <text class="main-title">{{detail.parkingNo || '-'}} 号车位</text>
      </view>

      <view class="tags-row" wx:if="{{detail.specs || detail.typeText || detail.buildings.length}}">
        <t-tag class="tag-item" variant="outline" theme="primary" size="small">{{detail.typeText}}</t-tag>
        <t-tag wx:if="{{detail.specs}}" class="tag-item" variant="outline" theme="default" size="small">{{detail.specs}}</t-tag>
        <t-tag wx:for="{{detail.buildingsText}}" wx:key="*this" class="tag-item" variant="light" theme="primary" size="small">{{item}}</t-tag>
      </view>
    </view>

    <view class="info-card">
      <view class="card-title">基本信息</view>
      <t-cell-group theme="card">
        <t-cell title="小区" note="{{detail.community || '-'}}" leftIcon="home" />
        <t-cell title="位置" note="{{detail.positionDesc || '-'}}" leftIcon="layers" />
        <t-cell title="规格" note="{{detail.specs || '-'}}" leftIcon="layers" />
        <t-cell title="联系电话" note="{{detail.phone || '-'}}" leftIcon="phone" />
        <t-cell wx:if="{{detail.auditRemark}}" title="驳回原因" note="{{detail.auditRemark}}" leftIcon="error-circle" note-class="reject-note" />
      </t-cell-group>
    </view>

    <view class="info-card" wx:if="{{detail.description}}">
      <view class="card-title">详细说明</view>
      <view class="text-block">{{detail.description}}</view>
    </view>

    <view class="info-card">
      <view class="card-title">车位照片</view>
      <view class="photo-grid">
        <image
          wx:for="{{swiperList}}"
          wx:key="*this"
          class="photo-item"
          src="{{item}}"
          mode="aspectFill"
          bind:tap="onPreview"
          data-index="{{index}}" />
      </view>
    </view>

    <view class="bottom-spacer"></view>

    <view class="bottom-bar">
      <view class="btn-actions">
        <t-button theme="light" content="联系房东" bind:tap="onCall" />
        <t-button theme="primary" content="立即预订" bind:tap="onBook" />
      </view>
    </view>
  </view>
</block>

<view wx:else class="page-container">
  <t-empty description="车位信息不存在" />
  <view class="bottom-spacer"></view>
</view>
