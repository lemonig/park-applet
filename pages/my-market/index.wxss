.my-market-page {
  min-height: 100vh;
  background-color: #f6f6f6;
  padding-bottom: 40rpx;
}

.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  padding: 16rpx 24rpx;
}

.list-section {
  padding: 0 24rpx;
}

.market-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-left {
  margin-right: 24rpx;
}

.card-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.parking-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-box {
  color: #fa4126;
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  font-weight: bold;
}

.amount {
  font-size: 36rpx;
  font-weight: bold;
  margin: 0 4rpx;
}

.unit {
  font-size: 22rpx;
  color: #999;
}

.card-actions {
  display: flex;
  gap: 12rpx;
}

.reject-remark {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff1f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fa4126;
}

.list-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}
