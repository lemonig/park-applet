/* 我的发布 —— 微信原生（WeUI）风格 */
.my-market-page {
  min-height: 100vh;
  background-color: var(--weui-bg, #ededed);
  padding-bottom: 40rpx;
}

.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  padding: 16rpx 24rpx;
}

.list-section {
  padding: 24rpx;
}

.market-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-left {
  margin-right: 24rpx;
}

.card-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.parking-number {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--weui-fg, rgba(0, 0, 0, 0.9));
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-box {
  color: var(--weui-red, #fa5151);
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  font-weight: bold;
}

.amount {
  font-size: 36rpx;
  font-weight: bold;
  margin: 0 4rpx;
}

.unit {
  font-size: 22rpx;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
}

.card-actions {
  display: flex;
  gap: 12rpx;
}

.reject-remark {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fceded;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--weui-red, #fa5151);
}

.list-tip {
  text-align: center;
  color: var(--weui-fg-3, rgba(0, 0, 0, 0.3));
  font-size: 24rpx;
  padding: 24rpx 0;
}
